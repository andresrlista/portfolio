---
import type { Dictionary } from '../i18n/en';
import SectionHeading from './SectionHeading.astro';

interface Props {
  t: Dictionary;
}

const { t } = Astro.props;
---

<section id="about" class="border-t border-[var(--border-subtle)] px-5 py-16 sm:px-8 sm:py-24">
  <div class="mx-auto max-w-5xl">
    <SectionHeading kicker={t.about.kicker} title={t.about.title} />
    <div class="reveal max-w-3xl space-y-5">
      {
        t.about.paragraphs.map((p) => (
          <p class="text-base leading-relaxed text-[var(--text-muted)] sm:text-lg">{p}</p>
        ))
      }
    </div>
  </div>
</section>
