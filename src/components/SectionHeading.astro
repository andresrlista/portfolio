---
interface Props {
  kicker: string;
  title: string;
}

const { kicker, title } = Astro.props;
---

<div class="reveal mb-10">
  <p class="font-mono text-xs font-medium uppercase tracking-widest text-[var(--accent)]">
    {kicker}
  </p>
  <h2 class="mt-2 text-2xl font-semibold tracking-tight text-[var(--text)] sm:text-3xl">
    {title}
  </h2>
</div>
