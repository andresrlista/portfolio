---
import type { Dictionary } from '../i18n/en';
import type { Locale } from '../i18n/utils';

interface Props {
  locale: Locale;
  t: Dictionary;
}

const { t } = Astro.props;
const year = new Date().getFullYear();
---

<footer class="border-t border-[var(--border-subtle)] px-5 py-8 sm:px-8">
  <div class="mx-auto flex max-w-5xl flex-col items-center justify-between gap-3 text-xs text-[var(--text-muted)] sm:flex-row">
    <p>© {year} Andrés Lista. {t.footer.rights}</p>
    <p class="font-mono">{t.footer.builtWith}</p>
    <a href="#main" class="transition-colors hover:text-[var(--text)]">
      {t.footer.backToTop} ↑
    </a>
  </div>
</footer>
